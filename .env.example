# .env.example — copiar a .env y rellenar con tus keys
# El fichero .env NO se sube a GitHub (está en .gitignore).

ALPACA_API_KEY=tu_api_key_aqui
ALPACA_SECRET_KEY=tu_secret_key_aqui

# Telegram — notificación diaria del autopiloto (solo en --env pro)
# Obtener token con @BotFather y chat_id con @userinfobot
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789
